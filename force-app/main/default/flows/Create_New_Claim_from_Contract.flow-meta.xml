        <locationX>314</locationX>
        <locationY>866</locationY>
        <defaultConnector>
            <targetReference>Create_New_Claim</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesClaimLimitExceed</name>
            <conditionLogic>2 AND (1 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>totalClaimCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Coverage_Level.Max_Number_of_Claims__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Coverage_Level</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Coverage_Level.Max_Number_of_Claims__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Limit_Exceed</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
