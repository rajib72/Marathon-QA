                </rightValue>
            </conditions>
            <connector>
                <targetReference>Funding_Alert</targetReference>
            </connector>
            <label>Not Funded</label>
        </rules>
        <rules>
            <name>Underfunded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contract.Contract_Term_Months__c</leftValueReference>
